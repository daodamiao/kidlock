<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Flutter 首帧绘制前的窗口主题（TV 深色） -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar.Fullscreen">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- Flutter 运行时的窗口背景 -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!-- 锁屏页主题：无标题、全屏、无切换动画 -->
    <style name="LockTheme" parent="@android:style/Theme.Black.NoTitleBar.Fullscreen">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
